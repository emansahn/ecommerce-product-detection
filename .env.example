# Application Configuration
APP_NAME=ecommerce-product-detection
APP_VERSION=0.1.0
DEBUG=True
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Model Configuration
MODEL_NAME=yolov8m
MODEL_PATH=models/weights/yolov8m.pt
CONFIDENCE_THRESHOLD=0.5
IOU_THRESHOLD=0.45

# Image Processing
IMAGE_SIZE=640
MAX_IMAGE_SIZE=2048
MIN_IMAGE_SIZE=320

# Database (Optional)
DB_URL=postgresql://user:password@localhost:5432/product_detection
DB_ECHO=False

# AWS/Storage Configuration (Optional)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET=product-detection-bucket

# Monitoring & Logging
SENTRY_DSN=
LOG_FORMAT=json
LOG_FILE=logs/app.log

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Cache Configuration
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600
